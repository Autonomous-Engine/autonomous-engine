# ── Bootstrap configuration ───────────────────────────────────────────────────
# These variables are the ONLY credentials managed via .env.
# All other integrations (LLM provider, GitHub, Jira) are configured through
# the admin dashboard at Admin → Models / Admin → Credentials.

# ── Database configuration ────────────────────────────────────────────────────
# Database user (also used by the postgres container)
DB_USER=ae_user

# Database password (also used by the postgres container). It is placed in
# DATABASE_URL, so avoid @ / : and similar characters; openssl rand -hex 16 is safe.
DB_PASSWORD=ae_password

# PostgreSQL connection URL, built from DB_USER and DB_PASSWORD
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@postgres:5432/autonomous_engine?sslmode=disable

# ── Kafka configuration ───────────────────────────────────────────────────────
# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=kafka:9092

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Leave empty for a single-node install: nothing needs Redis. Set it when you
# run more than one replica of a service, so the dashboard WebSocket fan-out
# and the rate limits (portal per-IP limit, LLM router) are shared between
# replicas. With compose, start the bundled Redis with
#   docker compose --profile scale up -d
# and set REDIS_URL=redis://redis:6379/0 here. If Redis becomes unreachable,
# the rate limits fall back to per-process counting and the dashboard to
# direct delivery (both logged and counted in ae_redis_fallback_total).
REDIS_URL=

# ── Security ─────────────────────────────────────────────────────────────────
# Master key for encrypting secrets stored in the credential registry (min 32 chars, base64)
# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=change-me-to-a-generated-base64-key

# Secret used for signing JWT session tokens
# Must be at least 32 bytes and not this placeholder; the dashboard refuses to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── Service ports ─────────────────────────────────────────────────────────────
# Dashboard backend API port
DASHBOARD_PORT=8080

# Dashboard UI port
DASHBOARD_UI_PORT=32900

# GitHub webhook listener port
WEBHOOK_PORT=8081

# GitHub webhook secret (optional fallback). The listener verifies every
# delivery's X-Hub-Signature-256 against the secret saved on the dashboard
# (Admin -> Integrations -> GitHub -> Webhook Secret) and uses this value only
# when none is saved there. With neither set, GitHub deliveries are refused.
GITHUB_WEBHOOK_SECRET=

# Work intake gateway port
GATEWAY_PORT=8082

# Onboarding service port (dashboard for initial setup)
ONBOARDING_PORT=3321

# Customer portal port
PORTAL_PORT=3100

# ── System / pool sizes ───────────────────────────────────────────────────────
# Number of concurrent research agent replicas
RESEARCH_POOL_SIZE=2

# Number of concurrent implementation agent replicas
IMPL_POOL_SIZE=1

# Number of concurrent QA agent replicas
QA_POOL_SIZE=1

# Maximum number of times a work item is retried before escalation
MAX_RETRY_COUNT=3

# Require human review before merging PRs (true|false)
HUMAN_REVIEW_REQUIRED=true

# ── Optional service URLs ─────────────────────────────────────────────────────
# Base URL of the internal github-service (override if port or hostname changes)
GITHUB_SERVICE_URL=http://github-service:8085

# Qdrant REST API endpoint
QDRANT_URL=http://qdrant:6333

# ── Worktree recovery (implementation-agent) ──────────────────────────────────
# Each task runs in its own git worktree (/repo-cache/<product>/worktree-<task-uuid>)
# tagged with a .ae-worktree.json marker. On startup the agent reclaims marker
# worktrees left behind by a crashed process. Directories without a marker are
# never touched.
#
# Startup reconciliation switch: on by default; off|0|false disables it.
AE_WORKTREE_RECONCILE=on
# A marker written on a different host is protected until it is older than this
# Go duration (default 24h). Set it above the longest expected task runtime.
AE_WORKTREE_STALE_AFTER=24h
# Upper bound for the startup scan (default 5m); leftovers wait for the next start.
AE_WORKTREE_RECONCILE_TIMEOUT=5m
# Root that clones and worktrees live under (default /repo-cache, the compose mount).
AE_REPO_CACHE_ROOT=/repo-cache
#
# Consequences to know about:
#  (a) implementation-agent runs as replicas with no fixed container_name, so a
#      `docker compose up -d` recreate assigns new hostnames. Worktrees orphaned
#      by a redeploy are therefore foreign-host and stay protected for
#      AE_WORKTREE_STALE_AFTER. Only an in-place restart of the same container
#      (crash, OOM kill, `docker restart`) reclaims them immediately via the
#      marker's instance_id.
#  (b) With two agent processes on one host (local development) set
#      AE_WORKTREE_RECONCILE=off: a same-host marker from another process
#      instance is treated as abandoned regardless of PID.
#  (c) Pre-upgrade worktree-<8hex> directories carry no marker. Reconcile counts
#      them as "unmarked" in its log line and ignores them; remove them once by
#      hand (`rm -rf /repo-cache/<product>/worktree-<8hex>` then
#      `git -C /repo-cache/<product>/<repo> worktree prune`).
#  (d) Worktrees created beside the /workspace/repo fallback clone (used only when
#      a repository lookup fails) are outside AE_REPO_CACHE_ROOT and are refused
#      with a warning by design.
#  (e) Writing a marker appends one line (.ae-worktree.json) to the clone's
#      .git/info/exclude so the marker is never committed to a task branch.

# ── Evidence release gate ─────────────────────────────────────────────────────
# Every implementation.complete message carries a verification evidence record
# and is released only when that record is `verified` (every recorded check passed).
# EVIDENCE_COMPAT_WINDOW is read by five services — status-orchestrator,
# implementation-planner, pr-coordinator, review-agent, and qa-agent — and
# governs what each does with a message that carries NO evidence, i.e. one
# from a pre-evidence producer still in flight (implementation.complete for
# the first three; the pr.ready / qa.ready messages derived from it, which
# must carry the verified head SHA, for review-agent and qa-agent):
#
#   legacy  (default when unset) — fall back to the old `success` boolean and
#           log a warning; each fallback increments the
#           ae_evidence_compat_legacy_fallback_total counter on the /metrics
#           endpoint of whichever of the five services took the fallback.
#   strict  — treat a message without evidence as blocked (fail closed).
#
# Any other value is treated as strict and logged at startup, so a typo can
# only narrow the gate, never widen it. Unknown evidence schema versions block
# in both modes.
#
# `legacy` exists only for the compatibility window while pre-evidence
# producers drain. Before flipping to `strict`: (1) every implementation-agent
# must be running the evidence-emitting build, (2) in-flight legacy `pr.ready`
# and `qa.ready` messages (published without a head SHA) must have drained —
# review-agent and qa-agent refuse them under strict — and (3) the
# ae_evidence_compat_legacy_fallback_total counter must read zero on all five
# services. All five read this same variable and MUST be flipped in the same
# change: they judge the same work, and a split configuration lets one
# service block a subtask whose dependents, PR, review, or QA another has
# already released (or vice versa).
EVIDENCE_COMPAT_WINDOW=legacy
