FROM golang:1.22-alpine AS builder
ARG SERVICE
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.version=$(git describe --tags --always 2>/dev/null || echo dev)" -o /service ./cmd/${SERVICE}

FROM alpine:3.19
RUN apk --no-cache add ca-certificates git
COPY --from=builder /service /service
COPY migrations/ /migrations/
ENTRYPOINT ["/service"]
