FROM node:20-alpine AS builder
WORKDIR /app
COPY portal/package.json portal/package-lock.json* ./
RUN npm install
COPY portal/ .
RUN npm run build

FROM golang:1.22-alpine AS api-builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /portal-api ./cmd/portal

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=api-builder /portal-api /portal-api
COPY --from=builder /app/dist /portal-static
ENTRYPOINT ["/portal-api"]
