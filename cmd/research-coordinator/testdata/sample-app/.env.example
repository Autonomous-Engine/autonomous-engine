# Station Finder - example environment. Copy to .env and adjust.
# Redis connection URL (station status cache and history)
REDIS_URL=redis://localhost:6379

# Directory for the importer's snapshots
DATA_DIR=./data

# HTTP port of the server
PORT=8700

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# City shown in the page title and the map's start position
CITY_NAME=Sample City
DEFAULT_LAT=40.0
DEFAULT_LON=-75.0
DEFAULT_ZOOM=13

# Station status feed (GBFS-style JSON) and how often to poll it
FEED_URL=https://feeds.example.org/stations.json
FEED_POLL_SECONDS=60
FEED_TIMEOUT_MS=10000

# How long a station without updates stays on the map, in seconds
STATION_TTL_SECONDS=900

# Hours of availability history kept per station
HISTORY_HOURS=24

# API limits
MAX_STATIONS=5000
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGIN=*

# Set to false to serve only the map app (no landing page at /)
LANDING_ENABLED=true