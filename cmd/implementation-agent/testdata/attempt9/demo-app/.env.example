# Redis connection URL
# Under Docker Compose use redis://redis:6379
REDIS_URL=redis://localhost:6379

# Directory for imported place data and search indexes
# Under Docker Compose this is the named volume mounted at /data
DATA_DIR=./var/places

# HTTP port for the web server
PORT=3080

# Maximum number of results returned by /search
SEARCH_LIMIT=25

# Seconds a cached /places response stays fresh
# Lower values show edits sooner; higher values spare Redis.
# Set to 0 to disable the response cache entirely.
CACHE_TTL_SECONDS=300

# Rows written per Redis pipeline during an import
# Raise it for large CSV files
IMPORT_BATCH_SIZE=500

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# How often the importer looks for new seed files (milliseconds)
REFRESH_INTERVAL_MS=60000

# Geocoder regions (used by dist/import/geocode.js)
# Valid values: all | a comma-separated list of region codes
GEOCODER_REGIONS=all

# Optional seed file loaded on first start (used by dist/import/seed.js)
# Point it at a CSV with name, category, lat and lon columns
# Leave unset to start with an empty map
# SEED_FILE=./seed/places.csv
